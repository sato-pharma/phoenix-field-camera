<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Where the tablet is, and the tablet's own report of it to Phoenix. Nothing else leaves. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Granted by Headwind, which is the device owner. Without it the rounds still run and every call says
         `locationPermission: "fine"` (or "none"), so Phoenix never reads a silent agent as a tablet that did not move. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The rounds come back by themselves after a restart. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_phoenix_service"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PhoenixPosition">

        <!-- The one-shot start, and the only component with a face.
             An app nothing has ever started is in Android's "stopped" state, where no broadcast reaches it — not even
             BOOT_COMPLETED — so something must start it once. Headwind's own "run after installation" starts an app
             through its launcher intent, which is why this activity exists at all. It draws NOTHING (no layout, no
             window: it finishes inside onCreate), schedules the rounds, and then DISABLES ITSELF, so the icon is gone
             from every launcher from that moment and the rep has nothing to open. The rounds and the restart receiver
             do not need it again. By hand, with the tablet on a cable:
                 adb shell am start -n com.satopharma.phoenixposition/.StartActivity -->
        <activity
            android:name=".StartActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.PhoenixPosition.Invisible">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The rounds after a restart, and after the app is updated. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Starting the rounds again from a cable without the icon coming back, once StartActivity has disabled
             itself: an `adb shell am broadcast` to this receiver with the action
             com.satopharma.phoenixposition.START and Android's include-stopped-packages flag (a disabled launcher
             icon leaves the app in the stopped state, where a plain broadcast never arrives). The whole command,
             with its flags, is in the README — an XML comment cannot hold a double hyphen.
             It schedules the rounds and answers nothing; there is no other action it can take. -->
        <receiver
            android:name=".StartReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="com.satopharma.phoenixposition.START" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
